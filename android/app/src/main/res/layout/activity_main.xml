<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0a0e14"
    android:keepScreenOn="true">

    <com.dobby.control.VideoView
        android:id="@+id/videoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Barre d'état -->
    <TextView
        android:id="@+id/txtStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:padding="6dp"
        android:background="#aa000000"
        android:textColor="#e7edf5"
        android:textSize="12sp"
        android:text="DÉSARMÉ" />

    <!-- Journal (logs) -->
    <TextView
        android:id="@+id/txtLog"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:padding="6dp"
        android:background="#aa000000"
        android:textColor="#9fe8c8"
        android:textSize="9sp"
        android:fontFamily="monospace"
        android:maxLines="14"
        android:text="journal…" />

    <!-- Joystick gauche -->
    <com.dobby.control.JoystickView
        android:id="@+id/stickLeft"
        android:layout_width="170dp"
        android:layout_height="170dp"
        android:layout_gravity="bottom|start"
        android:layout_margin="18dp" />

    <!-- Joystick droit -->
    <com.dobby.control.JoystickView
        android:id="@+id/stickRight"
        android:layout_width="170dp"
        android:layout_height="170dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="18dp" />

    <!-- Contrôles centraux -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/btnCam"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minWidth="0dp" android:text="CAM"
                android:backgroundTint="#1f2a38" android:textColor="#e7edf5" />
            <Button android:id="@+id/btnTakeoff"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minWidth="0dp" android:text="Décoller"
                android:backgroundTint="#14655d" android:textColor="#e7edf5" />
            <Button android:id="@+id/btnLand"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minWidth="0dp" android:text="Atterrir"
                android:backgroundTint="#8a6413" android:textColor="#e7edf5" />
            <Button android:id="@+id/btnStop"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minWidth="0dp" android:text="STOP"
                android:backgroundTint="#8a1f22" android:textColor="#e7edf5" />
        </LinearLayout>

        <!-- Boutons de test des commandes de vol (module 0x7D) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">
            <Button android:id="@+id/btnT03" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minWidth="0dp" android:padding="4dp" android:text="7D03"
                android:backgroundTint="#243244" android:textColor="#cfe" android:textSize="11sp" />
            <Button android:id="@+id/btnT04" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minWidth="0dp" android:padding="4dp" android:text="7D04"
                android:backgroundTint="#243244" android:textColor="#cfe" android:textSize="11sp" />
            <Button android:id="@+id/btnT08" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minWidth="0dp" android:padding="4dp" android:text="7D08"
                android:backgroundTint="#243244" android:textColor="#cfe" android:textSize="11sp" />
            <Button android:id="@+id/btnT0B" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minWidth="0dp" android:padding="4dp" android:text="7D0B"
                android:backgroundTint="#243244" android:textColor="#cfe" android:textSize="11sp" />
            <Button android:id="@+id/btnT11" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minWidth="0dp" android:padding="4dp" android:text="7D11"
                android:backgroundTint="#243244" android:textColor="#cfe" android:textSize="11sp" />
        </LinearLayout>

        <Switch android:id="@+id/swArm"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Armer" android:textColor="#7d8b9c" />
    </LinearLayout>
</FrameLayout>
